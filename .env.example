# Copy to .env.local — never commit real secrets.
NEXT_PUBLIC_SUPABASE_URL=https://paguvqqelfwadcolocaq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YCUtw2SaRw_K5v5yy3rz0w_dfTho-eD
# Server-only (Supabase dashboard → Project Settings → API keys). Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# LLM provider (TBD)
ANTHROPIC_API_KEY=

# Bedrock (intent embeddings). Local: an AWS CLI profile. Vercel: AWS_ROLE_ARN via OIDC, no keys.
AWS_PROFILE=bedrock
BEDROCK_REGION=us-east-1
AWS_ROLE_ARN=

# Demo sign-in gate. Set real values in .env.local / Vercel (Sensitive). SESSION_SECRET: 32+ random chars.
DEMO_USERNAME=
DEMO_PASSWORD=
SESSION_SECRET=

# Demo clock: relative dates ("ayer", "el martes") resolve against this day, the last one in the organizer's
# transactions (docs/conversation.md C4). Optional; defaults to 2026-06-17.
DEMO_TODAY=2026-06-17

# Step 8: the lookup's restricted database role (D-006). Written by pipeline/seed_test_users.py; server-only, Sensitive in Vercel.
SUPABASE_LOOKUP_DB_URL=

# Step 7 load (pipeline/load_supabase.py), local only. Supabase → Connect → "Session pooler" URI with the DB password.
SUPABASE_DB_URL=

# Experiment (docs/intent-model.md D18): Jev (TypeSafe) as the intent model behind a "Use Jev" toggle in the chat.
# Off unless JEV_TOGGLE=1 and a key is set. Server-only; mark the key Sensitive in Vercel. Not set in Production.
JEV_TOGGLE=
TYPESAFE_API_KEY=
