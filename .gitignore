# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data (never commit raw customer data)
/data/raw/*
!/data/raw/.gitkeep
!.env.example

# python
.venv/
__pycache__/

# local analytical DBs (rebuilt from data/raw)
/data/processed/*.duckdb
/data/processed/phrase_*

# local fallback model, fetched at build time (scripts/fetch-model.mjs)
/models/

# external datasets (fetched by scripts/download_*.sh; Banking77 is training-only, D-004)
/data/external/
/data/processed/banking77_*

# dbt
/pipeline/dbt/target/
/pipeline/dbt/logs/
/pipeline/dbt/dbt_packages/
/pipeline/dbt/.user.yml

# step 8 test logins (plaintext passwords, written by pipeline/seed_test_users.py)
test-users.local.md
*.local.md

# evaluation harness runs (evals/run.ts); reports are generated from them
/evals/runs/
